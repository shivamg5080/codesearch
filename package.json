{
  "name": "codesearch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "ingest:cf": "tsx scripts/ingest-codeforces.ts",
    "ingest:cc": "tsx scripts/ingest-codechef.ts",
    "ingest:lc": "tsx scripts/ingest-leetcode.ts",
    "ingest:cses": "tsx scripts/ingest-cses.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "eval:hints": "tsx evals/run-hint-leakage.ts",
    "eval:vernacular": "tsx evals/run-vernacular.ts",
    "eval:statistics:generate": "tsx evals/statistics-tutorial/generate-synthetic.ts",
    "agent:dev": "langgraphjs dev --port 2024 --no-browser",
    "dev:all": "concurrently -n next,agent -c cyan,magenta \"next dev\" \"npm run agent:dev\""
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.57",
    "@ag-ui/langgraph": "^0.0.42",
    "@ai-sdk/openai": "^3.0.77",
    "@auth/prisma-adapter": "^2.11.2",
    "@copilotkit/react-core": "^1.60.1",
    "@copilotkit/react-ui": "^1.60.1",
    "@copilotkit/runtime": "^1.60.1",
    "@langchain/core": "^1.2.1",
    "@langchain/langgraph": "^1.4.7",
    "@langchain/openai": "^1.5.3",
    "@prisma/client": "^6.19.3",
    "hono": "^4.12.27",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "openai": "^6.45.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "^1.4.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "playwright": "^1.61.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
